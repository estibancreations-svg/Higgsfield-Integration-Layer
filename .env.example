# Runtime
NODE_ENV=development
APP_NAME=Higgsfield-Integration-Layer
APP_BASE_URL=http://localhost:3000

# Higgsfield API
HIGGSFIELD_API_BASE_URL=https://api.higgsfield.ai
HIGGSFIELD_API_KEY=
HIGGSFIELD_ACCOUNT_ID=
HIGGSFIELD_REFRESH_TOKEN=
HIGGSFIELD_TOKEN_URL=https://api.higgsfield.ai/oauth/token
HIGGSFIELD_WEBHOOK_SECRET=
HIGGSFIELD_MINIMUM_CREDIT_BALANCE=10
HIGGSFIELD_LOW_CREDIT_THRESHOLD=25

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_DB_SCHEMA=public

# Auth and governance
INTEGRATION_API_KEY=
CEO_DASHBOARD_JWT_SECRET=
ARCHITECT_ACCOUNT_ID=master-ceo-dashboard
GOVERNANCE_SYSTEM_NAME=Master-System-Buildout
AUDIT_LOG_LEVEL=info

# Rate limiting and concurrency
DEFAULT_RATE_LIMIT=30
DEFAULT_RATE_LIMIT_WINDOW_MS=60000
DEFAULT_MAX_CONCURRENT_JOBS=5

# Notifications and alerts
LOW_CREDIT_ALERT_EMAIL=
LOW_CREDIT_ALERT_WEBHOOK=
